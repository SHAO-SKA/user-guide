msgstr "Public Cluster Directory"

#: ../../docs/data/transfer.rst:1 c5dda77208f44126a333d196fd43b65a
msgid "容器实例"
msgstr "Container Instance"

#: ../../docs/data/transfer.rst:1 4aeb94cce6fa4946a774619393ffb08b
