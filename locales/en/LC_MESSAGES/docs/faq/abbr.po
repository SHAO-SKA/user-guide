#: ../../docs/faq/abbr.rst:10 2720afc4357844b188f60f5016810019
msgid ""
"cnSRC is the abbreviation of China SKA Regional Centre Prototype, it is the "
"first prototype machine specially developed for the SKA regional center in "
"the world."
msgstr ""
"cnSRC is the abbreviation of China SKA Regional Centre Prototype, it is the "
"first prototype machine specially developed for the SKA regional center in "
"the world."

#: ../../docs/faq/abbr.rst:14 1310a4ac2b9044fc88afa5d02f7dbe46
msgid "SKA"
msgstr "SKA"

#: ../../docs/faq/abbr.rst:16 a011c0d5d53843e6a6e98a1b60834880
msgid ""
"SKA is the abbreviation of Square Kilometre Array, it is a radio telescope "
"with a diameter of one square kilometer. Details see: https://"
"www.skatelescope.org/"
msgstr ""
"SKA is the abbreviation of Square Kilometre Array, it is a radio telescope "
"with a diameter of one square kilometer. Details see: https://"
"www.skatelescope.org/"
