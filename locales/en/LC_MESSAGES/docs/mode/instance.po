#: ../../docs/mode/instance.rst:40 79405b6d8e3344deb3dd2c2b3998db9d
msgid "集群"
msgstr "Cluster"

#: ../../docs/mode/instance.rst:42 b1a19ff075b34dd1993ea46561307190
msgid "集群显示了当前资源所使用的节点和节点的详细信息。"
msgstr ""
"The cluster displays details of the nodes and nodes used by the current "
"resource."

#: ../../docs/mode/instance.rst:44 c24629588823489e802f7e89473b0650
msgid "|instance node information|"
msgstr "|instance node information|"

#: ../../docs/mode/instance.rst:255 9077912facab4adcaa27b22ea95b210a
