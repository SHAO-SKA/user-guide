#: ../../docs/mode/instance.rst:26 5eef3831787845dd9ee5e1dce5bcaa05
msgid "资源详情"
msgstr "Resource Detail"

#: ../../docs/mode/instance.rst:28 565c43984ccc4eecb23358ade74d7242
msgid "资源详情显示当前实例所使用的CPU核数、内存数、GPU数、块存储和镜像。"
msgstr ""
"Resource details show the number of CPU cores, memory, GPUs, block storage, "
"and mirrors used by the current instance."

#: ../../docs/mode/instance.rst:30 35bbc423c6a04be9bcd85c1c4b810e2e
msgid "|instance resource information|"
msgstr "|instance resource information|"

#: ../../docs/mode/instance.rst:253 044b0e2c0b9f462e94a99556fa79be0f
